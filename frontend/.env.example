# ============================================================
# ZhiYu Admin Web — 环境变量模板
# 复制此文件为 .env.development 或 .env.production 并填入实际值
# ============================================================

# API 基地址（生产由 nginx 反向代理，填空则使用相对路径）
VITE_API_BASE_URL=http://localhost:8080

# 浏览器标签页标题
VITE_APP_TITLE=ZhiYu Admin

# 是否启用 MSW mock（开发时后端未就绪则设为 true）
VITE_ENABLE_MOCK=false

# 前端日志级别: debug | info | warn | error
VITE_LOG_LEVEL=info

# Sentry 错误监控 DSN（可选）
VITE_SENTRY_DSN=

# Google Analytics ID（可选）
VITE_GA_ID=

# 生产构建是否移除 console.* 调用
VITE_BUILD_DROP_CONSOLE=false

# Vite dev server 端口
VITE_DEV_SERVER_PORT=5173
