# ============================================================
# ZhiYu-Backend — ufp-gateway-service 运行时镜像
#
# 适用环境: kubeadm 离线/本地部署
# 要求: 已通过 "./mvnw package" 预编译，并提取分层 JAR
#
# 构建:
#   java -Djarmode=layertools -jar backend/ufp/ufp-gateway-service/target/ufp-gateway-service-*.jar extract --destination backend/ufp/ufp-gateway-service/target/extracted
#   docker build -t zhiyu-gateway:latest -f deploy/docker/Dockerfile.gateway .
#
# 多架构:
#   docker build --platform linux/amd64 -t zhiyu-gateway:latest-amd64 .
#   docker build --platform linux/arm64 -t zhiyu-gateway:latest-arm64 .
#
# 支持架构: linux/amd64, linux/arm64
# ============================================================

# Stage 1: 构建前端 SPA
FROM node:22-alpine AS frontend-build
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# Stage 2: JRE 运行时
FROM eclipse-temurin:21-jre-alpine

ARG TARGETARCH

LABEL org.opencontainers.image.title="zhiyu-gateway"
LABEL org.opencontainers.image.description="ZhiYu API Gateway (Spring Cloud Gateway + SPA)"
LABEL org.opencontainers.image.architecture="${TARGETARCH}"

ARG SPRING_PROFILES_ACTIVE=dev
ENV SPRING_PROFILES_ACTIVE=${SPRING_PROFILES_ACTIVE}

RUN apk add --no-cache curl tzdata && \
    cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone && \
    addgroup -S zhiyu && adduser -S zhiyu -G zhiyu

WORKDIR /app

COPY --chown=zhiyu:zhiyu backend/ufp/ufp-gateway-service/target/extracted/dependencies/ ./
COPY --chown=zhiyu:zhiyu backend/ufp/ufp-gateway-service/target/extracted/spring-boot-loader/ ./
COPY --chown=zhiyu:zhiyu backend/ufp/ufp-gateway-service/target/extracted/snapshot-dependencies/ ./
COPY --chown=zhiyu:zhiyu backend/ufp/ufp-gateway-service/target/extracted/application/ ./

# 前端 SPA 静态文件
COPY --from=frontend-build --chown=zhiyu:zhiyu /frontend/dist/ /app/static/

USER zhiyu
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=60s \
  CMD curl -f http://localhost:8080/actuator/health/liveness || exit 1

ENTRYPOINT ["java", \
  "-XX:+UseZGC", \
  "-XX:MaxRAMPercentage=75.0", \
  "-XX:+ExitOnOutOfMemoryError", \
  "-Djava.security.egd=file:/dev/./urandom", \
  "-Dcsp.sentinel.log.dir=/tmp", \
  "org.springframework.boot.loader.launch.JarLauncher"]
