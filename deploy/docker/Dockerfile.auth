# ============================================================
# ZhiYu-Backend — ufp-auth-service 运行时镜像
#
# 适用环境: kubeadm 离线/本地部署
# 要求: 已通过 "./mvnw package" 预编译，并提取分层 JAR
#
# 构建:
#   java -Djarmode=layertools -jar backend/ufp/ufp-auth-service/target/ufp-auth-service-*.jar extract --destination backend/ufp/ufp-auth-service/target/extracted
#   docker build -t zhiyu-auth:latest -f deploy/docker/Dockerfile.auth .
#
# 支持架构: linux/amd64, linux/arm64
# ============================================================
FROM eclipse-temurin:21-jre-alpine

ARG TARGETARCH

LABEL org.opencontainers.image.title="zhiyu-auth"
LABEL org.opencontainers.image.description="ZhiYu Auth Service (JWT/OAuth/TOTP/WebAuthn)"
LABEL org.opencontainers.image.architecture="${TARGETARCH}"

ARG SPRING_PROFILES_ACTIVE=dev
ENV SPRING_PROFILES_ACTIVE=${SPRING_PROFILES_ACTIVE}

RUN apk add --no-cache curl tzdata && \
    cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone && \
    addgroup -S zhiyu && adduser -S zhiyu -G zhiyu

WORKDIR /app

COPY --chown=zhiyu:zhiyu backend/ufp/ufp-auth-service/target/extracted/dependencies/ ./
COPY --chown=zhiyu:zhiyu backend/ufp/ufp-auth-service/target/extracted/spring-boot-loader/ ./
COPY --chown=zhiyu:zhiyu backend/ufp/ufp-auth-service/target/extracted/snapshot-dependencies/ ./
COPY --chown=zhiyu:zhiyu backend/ufp/ufp-auth-service/target/extracted/application/ ./

USER zhiyu
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=60s \
  CMD curl -f http://localhost:8080/actuator/health/liveness || exit 1

ENTRYPOINT ["java", \
  "-XX:MaxRAMPercentage=75.0", \
  "-XX:+ExitOnOutOfMemoryError", \
  "-Djava.security.egd=file:/dev/./urandom", \
  "-Dcsp.sentinel.log.dir=/tmp", \
  "org.springframework.boot.loader.launch.JarLauncher"]
