{
  "uid": "zhiyu-k8s-pods",
  "title": "Kubernetes Pods - ZhiYu",
  "tags": ["kubernetes", "pods", "zhiyu"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "query": "label_values(kube_pod_info, namespace)",
        "multi": true,
        "includeAll": true,
        "allValue": "zhiyu.*|monitoring",
        "current": {"text": "zhiyu.*|monitoring", "value": ["zhiyu.*|monitoring"]},
        "label": "命名空间"
      },
      {
        "name": "pod",
        "type": "query",
        "query": "label_values(kube_pod_info{namespace=~\"$namespace\"}, pod)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {"text": "All", "value": ["$__all"]},
        "label": "Pod"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Pod 总数",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "targets": [
        {
          "expr": "count(kube_pod_info{namespace=~\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "总计",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"]},
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "运行中 Pod",
      "type": "stat",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{namespace=~\"$namespace\", pod=~\"$pod\", phase=\"Running\"})",
          "legendFormat": "运行中",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"]},
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": null}]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "异常 Pod",
      "type": "stat",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{namespace=~\"$namespace\", pod=~\"$pod\", phase!=\"Running\"})",
          "legendFormat": "异常",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"]},
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "总重启次数",
      "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "targets": [
        {
          "expr": "sum(kube_pod_container_status_restarts_total{namespace=~\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "重启次数",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"]},
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "重启速率 (5m)",
      "type": "stat",
      "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
      "targets": [
        {
          "expr": "sum(rate(kube_pod_container_status_restarts_total{namespace=~\"$namespace\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "重启速率",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"]},
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.01}]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "未就绪 Pod",
      "type": "stat",
      "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
      "targets": [
        {
          "expr": "count(kube_pod_status_ready{namespace=~\"$namespace\", pod=~\"$pod\", condition=\"false\"})",
          "legendFormat": "未就绪",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"]},
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]
          }
        }
      }
    },
    {
      "id": 10,
      "title": "Pod 状态表",
      "type": "table",
      "gridPos": {"x": 0, "y": 4, "w": 16, "h": 12},
      "targets": [
        {
          "expr": "kube_pod_info{namespace=~\"$namespace\", pod=~\"$pod\"} * on(pod, namespace) group_left(phase) (kube_pod_status_phase{namespace=~\"$namespace\", pod=~\"$pod\"} == 1)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {"id": "merge", "options": {}},
        {"id": "organize", "options": {
          "excludeByName": {"Time": true, "Value": true, "__name__": true, "job": true, "instance": true, "uid": true, "host_ip": true, "pod_ip": true, "created_by_kind": true, "created_by_name": true},
          "renameByName": {"namespace": "命名空间", "pod": "Pod", "phase": "状态", "node": "节点"}
        }}
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "auto"}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "状态"},
            "properties": [
              {"id": "mappings", "value": [
                {"type": "value", "value": "Running", "text": "运行中"},
                {"type": "value", "value": "Pending", "text": "等待中"},
                {"type": "value", "value": "Failed", "text": "失败"},
                {"type": "value", "value": "Succeeded", "text": "已完成"},
                {"type": "value", "value": "Unknown", "text": "未知"}
              ]}
            ]
          }
        ]
      }
    },
    {
      "id": 13,
      "title": "未就绪 Pod 详情",
      "type": "table",
      "gridPos": {"x": 16, "y": 4, "w": 8, "h": 12},
      "targets": [
        {
          "expr": "kube_pod_status_ready{namespace=~\"$namespace\", pod=~\"$pod\", condition=\"false\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {"id": "merge", "options": {}},
        {"id": "organize", "options": {
          "excludeByName": {"Time": true, "Value": true, "__name__": true, "job": true, "instance": true, "uid": true, "condition": true},
          "renameByName": {"namespace": "命名空间", "pod": "Pod"}
        }}
      ],
      "description": "Readiness probe 失败的 Pod（如有）"
    },
    {
      "id": 11,
      "title": "Pod 启动详情",
      "type": "table",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "kube_pod_container_status_restarts_total{namespace=~\"$namespace\", pod=~\"$pod\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "kube_pod_container_status_last_terminated_timestamp{namespace=~\"$namespace\", pod=~\"$pod\"}",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "kube_pod_start_time{namespace=~\"$namespace\", pod=~\"$pod\"}",
          "format": "table",
          "instant": true,
          "refId": "C"
        }
      ],
      "transformations": [
        {"id": "merge", "options": {}},
        {"id": "organize", "options": {
          "excludeByName": {"Time": true, "__name__": true, "job": true, "instance": true, "uid": true},
          "renameByName": {"namespace": "命名空间", "pod": "Pod", "container": "容器", "Value #A": "重启次数", "Value #B": "最后重启时间", "Value #C": "启动时间"},
          "sortBy": {"Value #A": "desc"}
        }}
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "auto"}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "最后重启时间"},
            "properties": [
              {"id": "unit", "value": "dateTimeAsIso"},
              {"id": "noValue", "value": "-"}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "启动时间"},
            "properties": [
              {"id": "unit", "value": "dateTimeAsIso"},
              {"id": "noValue", "value": "-"}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "重启次数"},
            "properties": [
              {"id": "decimals", "value": 0},
              {"id": "noValue", "value": "0"}
            ]
          }
        ]
      },
      "description": "所有容器的重启次数、最后重启时间及 Pod 启动时间（按重启次数降序）"
    },
    {
      "id": 12,
      "title": "Pod CPU 使用 (cores)",
      "type": "table",
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\", pod=~\"$pod\", container!=\"\", container!=\"POD\"}[5m])) by (namespace, pod)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {"id": "merge", "options": {}},
        {"id": "organize", "options": {
          "excludeByName": {"Time": true},
          "renameByName": {"namespace": "命名空间", "pod": "Pod", "Value": "CPU (cores)"},
          "sortBy": {"Value": "desc"}
        }}
      ],
      "fieldConfig": {
        "defaults": {"unit": "none", "decimals": 2}
      },
      "description": "过去 5 分钟每 Pod 的 CPU 用量"
    },
    {
      "id": 30,
      "title": "Pod 内存使用",
      "type": "table",
      "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=~\"$namespace\", pod=~\"$pod\", container!=\"\", container!=\"POD\"}) by (namespace, pod)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {"id": "merge", "options": {}},
        {"id": "organize", "options": {
          "excludeByName": {"Time": true},
          "renameByName": {"namespace": "命名空间", "pod": "Pod", "Value": "内存用量"},
          "sortBy": {"Value": "desc"}
        }}
      ],
      "fieldConfig": {
        "defaults": {"unit": "bytes", "decimals": 1}
      },
      "description": "每 Pod 当前内存用量（working set）"
    },
    {
      "id": 31,
      "title": "Pod 内存使用率 (%)",
      "type": "table",
      "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=~\"$namespace\", pod=~\"$pod\", container!=\"\", container!=\"POD\"}) by (pod) / sum(container_spec_memory_limit_bytes{namespace=~\"$namespace\", pod=~\"$pod\", container!=\"\", container!=\"POD\"}) by (pod) * 100",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {"id": "merge", "options": {}},
        {"id": "organize", "options": {
          "excludeByName": {"Time": true},
          "renameByName": {"pod": "Pod", "Value": "使用率 (%)"},
          "sortBy": {"Value": "desc"}
        }}
      ],
      "fieldConfig": {
        "defaults": {"unit": "percent", "decimals": 1, "max": 100},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "使用率 (%)"},
            "properties": [
              {"id": "thresholds", "value": {
                "mode": "absolute",
                "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 90}]
              }}
            ]
          }
        ]
      },
      "description": "Pod 内存使用率 = working_set / limit。超过 90% 有 OOM 风险"
    },
    {
      "id": 20,
      "title": "Pod CPU 使用趋势",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 32, "w": 12, "h": 10},
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\", pod=~\"$pod\", container!=\"\", container!=\"POD\"}[5m])) by (pod)",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 4,
          "custom": {"fillOpacity": 15, "lineWidth": 2, "spanNulls": true}
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}
      },
      "description": "各 Pod CPU 使用趋势（cores），5 分钟速率"
    },
    {
      "id": 21,
      "title": "Pod 内存使用趋势",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 32, "w": 12, "h": 10},
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=~\"$namespace\", pod=~\"$pod\", container!=\"\", container!=\"POD\"}) by (pod)",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {"fillOpacity": 15, "lineWidth": 2, "spanNulls": true}
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}
      },
      "description": "各 Pod 内存使用趋势，可发现内存泄漏模式"
    }
  ]
}
