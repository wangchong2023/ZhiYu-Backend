{
  "uid": "zhiyu-k8s-pods",
  "title": "Kubernetes Pods - ZhiYu",
  "tags": ["kubernetes", "pods", "zhiyu"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Pod 总数",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "count(kube_pod_info{namespace=~\"zhiyu.*|monitoring\"})",
          "legendFormat": "总计",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"]},
        "textMode": "auto"
      },
      "description": "zhiyu + monitoring 命名空间的 Pod 总数"
    },
    {
      "id": 2,
      "title": "运行中 Pod",
      "type": "stat",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{namespace=~\"zhiyu.*|monitoring\", phase=\"Running\"})",
          "legendFormat": "运行中",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"]},
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": null}]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "异常 Pod",
      "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{namespace=~\"zhiyu.*|monitoring\", phase!=\"Running\"})",
          "legendFormat": "异常",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"]},
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "总重启次数",
      "type": "stat",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "sum(kube_pod_container_status_restarts_total{namespace=~\"zhiyu.*|monitoring\"})",
          "legendFormat": "重启次数",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"]},
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]
          }
        }
      }
    },
    {
      "id": 10,
      "title": "Pod 状态表",
      "type": "table",
      "gridPos": {"x": 0, "y": 4, "w": 24, "h": 12},
      "targets": [
        {
          "expr": "kube_pod_info{namespace=~\"zhiyu.*|monitoring\"} * on(pod, namespace) group_left(phase) (kube_pod_status_phase{namespace=~\"zhiyu.*|monitoring\"} == 1)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {"id": "merge", "options": {}},
        {"id": "organize", "options": {
          "excludeByName": {"Time": true, "Value": true, "__name__": true, "job": true, "instance": true, "uid": true, "host_ip": true, "pod_ip": true, "created_by_kind": true, "created_by_name": true},
          "renameByName": {"namespace": "命名空间", "pod": "Pod", "phase": "状态", "node": "节点"}
        }}
      ],
      "description": "所有相关命名空间的 Pod 状态"
    },
    {
      "id": 11,
      "title": "Pod 重启详情",
      "type": "table",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "kube_pod_container_status_restarts_total{namespace=~\"zhiyu.*|monitoring\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "kube_pod_container_status_last_terminated_timestamp{namespace=~\"zhiyu.*|monitoring\"}",
          "format": "table",
          "instant": true,
          "refId": "B"
        }
      ],
      "transformations": [
        {"id": "merge", "options": {}},
        {"id": "organize", "options": {
          "excludeByName": {"Time": true, "__name__": true, "job": true, "instance": true, "uid": true},
          "renameByName": {"namespace": "命名空间", "pod": "Pod", "container": "容器", "Value #A": "重启次数", "Value #B": "最后重启时间"}
        }}
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "最后重启时间"},
            "properties": [
              {"id": "unit", "value": "dateTimeAsIso"},
              {"id": "custom.cellOptions", "value": {"type": "auto"}}
            ]
          }
        ]
      },
      "description": "所有容器的重启次数及最后重启时间"
    },
    {
      "id": 12,
      "title": "Pod CPU 使用 (cores)",
      "type": "table",
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=~\"zhiyu.*|monitoring\", container!=\"\", container!=\"POD\"}[5m])) by (namespace, pod)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {"id": "merge", "options": {}},
        {"id": "organize", "options": {
          "excludeByName": {"Time": true},
          "renameByName": {"namespace": "命名空间", "pod": "Pod", "Value": "CPU (cores)"}
        }}
      ],
      "fieldConfig": {
        "defaults": {"unit": "short", "decimals": 4}
      },
      "description": "过去 5 分钟每 Pod 的 CPU 用量"
    },
    {
      "id": 20,
      "title": "Pod CPU 使用趋势",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 24, "w": 24, "h": 10},
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=~\"zhiyu.*|monitoring\", container!=\"\", container!=\"POD\"}[5m])) by (pod)",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 4,
          "custom": {"fillOpacity": 15, "lineWidth": 2, "spanNulls": true}
        }
      },
      "description": "各 Pod 的 CPU 使用趋势（cores），5 分钟速率"
    }
  ]
}
