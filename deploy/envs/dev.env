# ============================================================
# 开发环境变量 (dev)
# 用法: source deploy/envs/dev.env
# ============================================================

# K8s
export K8S_NAMESPACE="zhiyu-dev"

# 应用
export APP_REPLICAS="1"
export APP_CPU_REQUEST="250m"
export APP_CPU_LIMIT="500m"
export APP_MEM_REQUEST="256Mi"
export APP_MEM_LIMIT="512Mi"

# 镜像
export DOCKER_REGISTRY="registry.cn-hangzhou.aliyuncs.com"
export DOCKER_IMAGE="zhiyu/zhiyu-backend"
export DOCKER_TAG="dev-$(date +%Y%m%d-%H%M%S)"

# MySQL (开发环境在 K8s 内)
export MYSQL_HOST="mysql.${K8S_NAMESPACE}"
export MYSQL_PORT="3306"
export MYSQL_DATABASE="zhiyu_dev"
export MYSQL_USER="zhiyu"
export MYSQL_PASSWORD="Jsw2JPNkPS2GkLo8bBhY"
export MYSQL_ROOT_PASSWORD="jvEs5IQHQryk0reskGYX2QJ4"
export MYSQL_STORAGE="5Gi"

# Redis
export REDIS_HOST="redis.${K8S_NAMESPACE}"
export REDIS_PORT="6379"
export REDIS_PASSWORD="gAO6PqzIy0HvBcc66SH2"
export REDIS_STORAGE="1Gi"

# Nacos
export NACOS_HOST="nacos.${K8S_NAMESPACE}"
export NACOS_PORT="8848"
export NACOS_NAMESPACE="dev"
export NACOS_STORAGE="1Gi"
export NACOS_USERNAME="nacos"
export NACOS_PASSWORD="81OdXSjL4fWYPllJ"
export NACOS_IDENTITY_KEY="serverIdentity"
export NACOS_IDENTITY_VALUE="security"

# Nacos
export NACOS_CONFIG_ENABLED="true"
export NACOS_DISCOVERY_ENABLED="false"

# Spring
export SPRING_PROFILES_ACTIVE="dev"

# JWT (开发环境自动生成)
export JWT_KEY_DIR="./deploy/secrets/dev"

# HPA
export HPA_MIN_REPLICAS="1"
export HPA_MAX_REPLICAS="4"

# PDB
export PDB_MIN_AVAILABLE="1"

# Ingress
export INGRESS_HOST="dev.zhiyu.app"
export INGRESS_CLASS="nginx"
export INGRESS_SSL_REDIRECT="false"
