# ============================================================
# 生产环境自定义覆盖文件 (custom.env)
# ============================================================
# 用法: 生产部署时只需编辑此文件，deploy.sh 会自动加载覆盖默认值。
#       source deploy/envs/release/custom.env
#       ./deploy/deploy.sh release all
#
# 此文件覆盖 deploy/envs/release/config.env 中的默认值。
# 所有需按实际生产环境修改的变量集中在此，无需搜索多个文件。
# ============================================================

# ── K8s 命名空间 ──────────────────────
export K8S_NAMESPACE="zhiyu"

# ── 应用副本与资源 ────────────────────
export APP_REPLICAS="4"
export APP_CPU_REQUEST="1000m"
export APP_CPU_LIMIT="2000m"
export APP_MEM_REQUEST="1Gi"
export APP_MEM_LIMIT="2Gi"

# ── 镜像仓库（阿里云 ACR） ────────────
export DOCKER_REGISTRY="registry.cn-hangzhou.aliyuncs.com"
export DOCKER_IMAGE="zhiyu/zhiyu-backend"
export DOCKER_TAG="release-$(git describe --tags --always 2>/dev/null || echo 'latest')"

# ── MySQL (外部 RDS / 自建) ──────────
# 生产环境使用外部 MySQL，以下为必填项
export MYSQL_HOST="your-mysql-host.example.com"
export MYSQL_PORT="3306"
export MYSQL_DATABASE="zhiyu"
export MYSQL_USER="zhiyu_app"
export MYSQL_PASSWORD=""             # 填入 MySQL 密码
export MYSQL_ROOT_PASSWORD=""        # 填入 MySQL root 密码（仅初始化时用）
export MYSQL_STORAGE=""              # 空 = 使用外部 MySQL，不创建 K8s StatefulSet

# 第二个数据库：UFP 认证授权平台（同实例、同账号）
export UFP_AUTH_DATABASE="ufp_auth"
export UFP_AUTH_MYSQL_HOST="${MYSQL_HOST}"
export UFP_AUTH_MYSQL_PORT="${MYSQL_PORT}"
export UFP_AUTH_MYSQL_USER="${MYSQL_USER}"
export UFP_AUTH_MYSQL_PASSWORD="${MYSQL_PASSWORD}"

# ── Redis (外部 Sentinel / 自建) ──────
export REDIS_HOST="your-redis-host.example.com"
export REDIS_PORT="6379"
export REDIS_PASSWORD=""             # 填入 Redis 密码
export REDIS_STORAGE=""              # 空 = 使用外部 Redis

# ── Nacos (外部集群) ──────────────────
export NACOS_HOST="your-nacos-host.example.com"
export NACOS_PORT="8848"
export NACOS_NAMESPACE="release"
export NACOS_USERNAME="nacos"
export NACOS_PASSWORD=""             # 填入 Nacos 密码（或通过 CI/CD Secret 注入）
export NACOS_STORAGE=""              # 空 = 使用外部 Nacos

# Nacos 功能开关
export NACOS_CONFIG_ENABLED="true"
export NACOS_DISCOVERY_ENABLED="true"

# ── Spring Profile ────────────────────
export SPRING_PROFILES_ACTIVE="release"

# ── JWT 密钥 ──────────────────────────
# 生产环境建议使用外部密钥管理（SealedSecret / ExternalSecret）
export JWT_KEY_DIR="./deploy/secrets/release"

# ── Ingress ───────────────────────────
export INGRESS_HOST="api.zhiyu.app"
export INGRESS_CLASS="nginx"
export INGRESS_TLS_SECRET="zhiyu-release-tls"
export INGRESS_SSL_REDIRECT="true"

# ── HPA 自动扩缩容 ───────────────────
export HPA_MIN_REPLICAS="2"
export HPA_MAX_REPLICAS="12"

# ── PDB 最小可用 ─────────────────────
export PDB_MIN_AVAILABLE="2"

# ── 前端 admin-web ────────────────────
export ADMIN_WEB_REPLICAS="2"
export ADMIN_WEB_CPU_REQUEST="100m"
export ADMIN_WEB_CPU_LIMIT="500m"
export ADMIN_WEB_MEM_REQUEST="128Mi"
export ADMIN_WEB_MEM_LIMIT="256Mi"

# ── 监控 ──────────────────────────────
export PROMETHEUS_STORAGE="50Gi"
export GRAFANA_STORAGE="10Gi"
export GRAFANA_PASSWORD=""           # 填入 Grafana 管理员密码

# ── 通知（告警通道） ──────────────────
export ALERT_WEBHOOK_URL=""          # 填入告警 Webhook URL（企业微信/钉钉/Slack）
export SMTP_HOST=""                  # 邮件告警 SMTP
export SMTP_PORT="587"
export SMTP_USER=""
export SMTP_PASSWORD=""
