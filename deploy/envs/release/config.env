# ============================================================
# 生产环境变量 (release)
# 用法: source deploy/envs/release.env
# ============================================================
# 警告：生产环境凭据不应在此文件中明文定义
#       实际部署时通过 CI/CD 环境变量或外部密钥管理注入
# ============================================================

# K8s
export K8S_NAMESPACE="zhiyu"

# 应用
export APP_REPLICAS="4"
export APP_CPU_REQUEST="1000m"
export APP_CPU_LIMIT="2000m"
export APP_MEM_REQUEST="1Gi"
export APP_MEM_LIMIT="2Gi"

# 镜像
export DOCKER_REGISTRY="registry.cn-hangzhou.aliyuncs.com"
export DOCKER_IMAGE="zhiyu/zhiyu-backend"
export DOCKER_TAG="release-$(git describe --tags --always 2>/dev/null || echo 'latest')"

# MySQL (RDS 主从)
export MYSQL_HOST=""
export MYSQL_PORT="3306"
export MYSQL_DATABASE="zhiyu"
export MYSQL_USER=""
export MYSQL_STORAGE=""

# Redis (Sentinel 集群)
export REDIS_HOST=""
export REDIS_PORT="6379"
export REDIS_STORAGE=""

# Nacos (外部集群)
export NACOS_HOST=""
export NACOS_PORT="8848"
export NACOS_NAMESPACE="release"
export NACOS_STORAGE=""
export NACOS_USERNAME=""
# NACOS_PASSWORD 应在 CI/CD Secret 中设置

# Nacos
export NACOS_CONFIG_ENABLED="true"
export NACOS_DISCOVERY_ENABLED="false"

# Spring
export SPRING_PROFILES_ACTIVE="release"

# JWT
export JWT_KEY_DIR="./deploy/secrets/release"

# Ingress
export INGRESS_HOST="api.zhiyu.app"
export INGRESS_CLASS="nginx"
export INGRESS_TLS_SECRET="zhiyu-release-tls"
export INGRESS_SSL_REDIRECT="true"

# ── cert-manager / Let's Encrypt ──────────
# 生产环境使用 Let's Encrypt Production，证书有效期 90 天，cert-manager 自动在到期前 30 天续签
# 速率限制：每个注册域名每周最多 50 个证书，请勿频繁重建
export CERT_MANAGER_ENABLED="true"
export CERT_MANAGER_CLUSTER_ISSUER="letsencrypt-prod"
export ACME_EMAIL="ops@zhiyu.app"
export ACME_SERVER="https://acme-v02.api.letsencrypt.org/directory"
export CERT_MANAGER_ANNOTATION='cert-manager.io/cluster-issuer: "letsencrypt-prod"'

# HPA
export HPA_MIN_REPLICAS="2"
export HPA_MAX_REPLICAS="12"

# PDB
export PDB_MIN_AVAILABLE="2"
