# ============================================================
# 预发布环境变量 (staging)
# 用法: source deploy/envs/staging.env
# ============================================================

# K8s
export K8S_NAMESPACE="zhiyu-staging"

# ═══════════════════════════════════════════════════════════════
# 微服务资源配额（Phase 2 拆分: 3 个独立可部署服务）
# ═══════════════════════════════════════════════════════════════

# ── ufp-gateway (API 网关 + 前端 SPA) ──────────────────────
export GATEWAY_REPLICAS="2"
export GATEWAY_CPU_REQUEST="300m"
export GATEWAY_CPU_LIMIT="600m"
export GATEWAY_MEM_REQUEST="384Mi"
export GATEWAY_MEM_LIMIT="768Mi"
export GATEWAY_NODE_PORT="30080"

# ── ufp-auth (认证服务) ─────────────────────────────────────
export AUTH_REPLICAS="2"
export AUTH_CPU_REQUEST="500m"
export AUTH_CPU_LIMIT="1000m"
export AUTH_MEM_REQUEST="512Mi"
export AUTH_MEM_LIMIT="1Gi"

# ── zhiyu-admin (业务聚合) ──────────────────────────────────
export ADMIN_SVC_REPLICAS="2"
export ADMIN_SVC_CPU_REQUEST="500m"
export ADMIN_SVC_CPU_LIMIT="1000m"
export ADMIN_SVC_MEM_REQUEST="512Mi"
export ADMIN_SVC_MEM_LIMIT="1Gi"

# ═══════════════════════════════════════════════════════════════
# 镜像
# Phase 2: ufp-auth + zhiyu-admin 当前共用 zhiyu-server 镜像
# ═══════════════════════════════════════════════════════════════
export DOCKER_REGISTRY="registry.cn-hangzhou.aliyuncs.com"
export DOCKER_TAG="staging-$(date +%Y%m%d-%H%M%S)"
export IMAGE_PULL_POLICY="IfNotPresent"
export SKIP_PUSH="false"

export GATEWAY_IMAGE="zhiyu/zhiyu-gateway"
export AUTH_IMAGE="zhiyu/zhiyu-auth"
export ADMIN_SVC_IMAGE="zhiyu/zhiyu-admin"

# MySQL (RDS 外部实例)
export MYSQL_HOST="rm-xxxxxx.mysql.rds.aliyuncs.com"
export MYSQL_PORT="3306"
export MYSQL_DATABASE="zhiyu_staging"
export MYSQL_USER="zhiyu"
# MYSQL_PASSWORD 和 MYSQL_ROOT_PASSWORD 应在 Secret 中手动设置
export MYSQL_STORAGE=""

# Redis (外部 Sentinel)
export REDIS_HOST="r-xxxxxx.redis.rds.aliyuncs.com"
export REDIS_PORT="6379"
export REDIS_STORAGE=""

# Nacos (外部集群)
export NACOS_HOST="nacos.staging.internal"
export NACOS_PORT="8848"
export NACOS_NAMESPACE="staging"
export NACOS_STORAGE=""
export NACOS_USERNAME="nacos"
# NACOS_PASSWORD 应在 CI/CD Secret 中设置

# Nacos
export NACOS_CONFIG_ENABLED="true"
export NACOS_DISCOVERY_ENABLED="false"

# Spring
export SPRING_PROFILES_ACTIVE="staging"

# JWT (预发布使用独立密钥)
export JWT_KEY_DIR="./deploy/secrets/staging"

# Ingress
export INGRESS_HOST="staging.zhiyu.app"
export INGRESS_CLASS="nginx"
export INGRESS_TLS_SECRET="zhiyu-staging-tls"
export INGRESS_SSL_REDIRECT="true"

# ── cert-manager / Let's Encrypt ──────────
# staging 环境使用 Let's Encrypt Staging，避免因频繁部署触发生产环境速率限制
export CERT_MANAGER_ENABLED="true"
export CERT_MANAGER_CLUSTER_ISSUER="letsencrypt-staging"
export ACME_EMAIL="ops@zhiyu.app"
export ACME_SERVER="https://acme-staging-v02.api.letsencrypt.org/directory"
export CERT_MANAGER_ANNOTATION='cert-manager.io/cluster-issuer: "letsencrypt-staging"'

# HPA（每服务独立扩缩容）
export GATEWAY_HPA_MIN="2"
export GATEWAY_HPA_MAX="6"
export AUTH_HPA_MIN="2"
export AUTH_HPA_MAX="8"
export ADMIN_SVC_HPA_MIN="2"
export ADMIN_SVC_HPA_MAX="8"

# PDB（每服务独立中断保护）
export GATEWAY_PDB_MIN="1"
export AUTH_PDB_MIN="1"
export ADMIN_SVC_PDB_MIN="1"
