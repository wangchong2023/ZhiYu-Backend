# ============================================================
# 开发环境变量 (dev)
# 用法: source deploy/envs/dev.env
# ============================================================

# K8s
export K8S_NAMESPACE="zhiyu-dev"

# ═══════════════════════════════════════════════════════════════
# 微服务资源配额（Phase 2 拆分: 3 个独立可部署服务）
# ═══════════════════════════════════════════════════════════════

# ── ufp-gateway (API 网关 + 前端 SPA) ──────────────────────
export GATEWAY_REPLICAS="1"
export GATEWAY_CPU_REQUEST="200m"
export GATEWAY_CPU_LIMIT="500m"
export GATEWAY_MEM_REQUEST="256Mi"
export GATEWAY_MEM_LIMIT="512Mi"
export GATEWAY_NODE_PORT="30080"

# ── ufp-auth (认证服务) ─────────────────────────────────────
export AUTH_REPLICAS="1"
export AUTH_CPU_REQUEST="250m"
export AUTH_CPU_LIMIT="500m"
export AUTH_MEM_REQUEST="256Mi"
export AUTH_MEM_LIMIT="512Mi"

# ── zhiyu-admin (业务聚合) ──────────────────────────────────
export ADMIN_SVC_REPLICAS="1"
export ADMIN_SVC_CPU_REQUEST="250m"
export ADMIN_SVC_CPU_LIMIT="500m"
export ADMIN_SVC_MEM_REQUEST="256Mi"
export ADMIN_SVC_MEM_LIMIT="512Mi"

# ═══════════════════════════════════════════════════════════════
# 镜像 — 3 个独立镜像对应 3 个微服务 Pod
# ═══════════════════════════════════════════════════════════════
export DOCKER_REGISTRY="registry.cn-hangzhou.aliyuncs.com"
export DOCKER_TAG="dev-$(date +%Y%m%d-%H%M%S)"
export IMAGE_PULL_POLICY="IfNotPresent"
export SKIP_PUSH="false"

export GATEWAY_IMAGE="zhiyu/zhiyu-gateway"
export AUTH_IMAGE="zhiyu/zhiyu-auth"
export ADMIN_SVC_IMAGE="zhiyu/zhiyu-admin"

# MySQL (开发环境在 K8s 内)
# 密码由 deploy/scripts/ensure-secrets.sh 首次自动生成，存于 deploy/secrets/dev/passwords.env
# 自定义密码: export MYSQL_PASSWORD="your-pw" && source deploy/envs/dev.env
export MYSQL_HOST="mysql.${K8S_NAMESPACE}"
export MYSQL_PORT="3306"
export MYSQL_DATABASE="zhiyu_dev"
export MYSQL_USER="zhiyu"
export MYSQL_PASSWORD="${MYSQL_PASSWORD:-}"
export MYSQL_ROOT_PASSWORD="${MYSQL_ROOT_PASSWORD:-}"
export MYSQL_STORAGE="5Gi"

# Redis
export REDIS_HOST="redis.${K8S_NAMESPACE}"
export REDIS_PORT="6379"
export REDIS_PASSWORD="${REDIS_PASSWORD:-}"
export REDIS_STORAGE="1Gi"

# Nacos
export NACOS_HOST="nacos.${K8S_NAMESPACE}"
export NACOS_PORT="8848"
export NACOS_NAMESPACE="dev"
export NACOS_STORAGE="1Gi"
export NACOS_USERNAME="nacos"
export NACOS_PASSWORD="${NACOS_PASSWORD:-}"
export NACOS_IDENTITY_KEY="${NACOS_IDENTITY_KEY:-serverIdentity}"
export NACOS_IDENTITY_VALUE="${NACOS_IDENTITY_VALUE:-security}"

# Nacos
export NACOS_CONFIG_ENABLED="true"
export NACOS_DISCOVERY_ENABLED="false"

# Spring
export SPRING_PROFILES_ACTIVE="dev"

# JWT (开发环境自动生成)
export JWT_KEY_DIR="./deploy/secrets/dev"

# HPA（每服务独立扩缩容）
export GATEWAY_HPA_MIN="1"
export GATEWAY_HPA_MAX="4"
export AUTH_HPA_MIN="1"
export AUTH_HPA_MAX="4"
export ADMIN_SVC_HPA_MIN="1"
export ADMIN_SVC_HPA_MAX="4"

# PDB（每服务独立中断保护）
export GATEWAY_PDB_MIN="1"
export AUTH_PDB_MIN="1"
export ADMIN_SVC_PDB_MIN="1"

# Ingress
export INGRESS_HOST="dev.zhiyu.app"
export INGRESS_CLASS="nginx"
export INGRESS_SSL_REDIRECT="false"

# ── cert-manager / Let's Encrypt ──────────
# dev 环境默认不启用自动 TLS（根据实际域名情况可选启用）
export CERT_MANAGER_ENABLED="false"
export CERT_MANAGER_CLUSTER_ISSUER=""
export ACME_EMAIL=""
export ACME_SERVER=""
export CERT_MANAGER_ANNOTATION=""
