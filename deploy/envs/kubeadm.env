# ============================================================
# Kubeadm (标准 K8s) 环境变量
# 用法: source deploy/envs/kubeadm.env
# 用于本地/开发服务器 kubeadm 部署，不使用外部镜像仓库
#
# 安全说明: 密码为自动生成的强密码，仅用于开发环境。
# 生产环境请使用外部密钥管理（SealedSecret / ExternalSecret）。
# 若需修改已部署的数据库密码，需手动在数据库内执行 ALTER USER。
# ============================================================

# K8s
export K8S_NAMESPACE="zhiyu-dev"

# 应用
export APP_REPLICAS="1"
export APP_CPU_REQUEST="250m"
export APP_CPU_LIMIT="500m"
export APP_MEM_REQUEST="512Mi"
export APP_MEM_LIMIT="1Gi"

# 镜像 — 无 registry，镜像通过 ctr 导入 containerd
export DOCKER_REGISTRY=""
export DOCKER_IMAGE="zhiyu-backend"
export DOCKER_TAG="latest"
export IMAGE_PULL_POLICY="IfNotPresent"
export SKIP_PUSH="true"

# MySQL (K8s 内 StatefulSet)
# 密码由 deploy/scripts/ensure-secrets.sh 首次自动生成，存于 deploy/secrets/kubeadm/passwords.env
export MYSQL_HOST="mysql.${K8S_NAMESPACE}"
export MYSQL_PORT="3306"
export MYSQL_DATABASE="zhiyu_dev"
export MYSQL_USER="zhiyu"
export MYSQL_PASSWORD="${MYSQL_PASSWORD:-}"
export MYSQL_ROOT_PASSWORD="${MYSQL_ROOT_PASSWORD:-}"
export MYSQL_STORAGE="1Gi"

# Redis
export REDIS_HOST="redis.${K8S_NAMESPACE}"
export REDIS_PORT="6379"
export REDIS_PASSWORD="${REDIS_PASSWORD:-}"
export REDIS_STORAGE="512Mi"

# Nacos (kubeadm 环境不部署 Nacos，显式禁用)
export NACOS_HOST="nacos.${K8S_NAMESPACE}"
export NACOS_PORT="8848"
export NACOS_NAMESPACE="dev"
export NACOS_STORAGE=""
export NACOS_USERNAME="nacos"
export NACOS_PASSWORD="${NACOS_PASSWORD:-}"
export NACOS_CONFIG_ENABLED="false"
export NACOS_DISCOVERY_ENABLED="false"

# Spring
export SPRING_PROFILES_ACTIVE="dev"

# JWT
export JWT_KEY_DIR="./deploy/secrets/kubeadm"

# HPA
export HPA_MIN_REPLICAS="1"
export HPA_MAX_REPLICAS="2"

# PDB
export PDB_MIN_AVAILABLE="1"

# Monitoring
export PROMETHEUS_STORAGE="10Gi"
export GRAFANA_STORAGE="1Gi"
export GRAFANA_PASSWORD="${GRAFANA_PASSWORD:-}"

# ── 镜像版本（可覆盖） ──────────────────────
export MYSQL_IMAGE="mysql:8.0"
export REDIS_IMAGE="redis:7-alpine"
export NACOS_IMAGE="nacos/nacos-server:v2.4.0"
export BUSYBOX_IMAGE="busybox:1.36"
export PROMETHEUS_IMAGE="prom/prometheus:v3.7.0"
export GRAFANA_IMAGE="grafana/grafana:11.6.0"
export KUBE_STATE_METRICS_IMAGE="registry.k8s.io/kube-state-metrics/kube-state-metrics:v2.15.0"
export NODE_EXPORTER_IMAGE="prom/node-exporter:v1.9.0"

# Ingress
export INGRESS_HOST="localhost"
export INGRESS_CLASS="nginx"
export INGRESS_SSL_REDIRECT="false"
