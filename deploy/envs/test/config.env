# ============================================================
# 测试环境变量 (test)
# 用法: source deploy/envs/test.env
# 用于集成测试和 QA 验证，使用外部托管服务
# ============================================================

# K8s
export K8S_NAMESPACE="zhiyu-test"

# 应用
export APP_REPLICAS="2"
export APP_CPU_REQUEST="500m"
export APP_CPU_LIMIT="1000m"
export APP_MEM_REQUEST="512Mi"
export APP_MEM_LIMIT="1Gi"

# 镜像
export DOCKER_REGISTRY="registry.cn-hangzhou.aliyuncs.com"
export DOCKER_IMAGE="zhiyu/zhiyu-backend"
export DOCKER_TAG="test-$(date +%Y%m%d-%H%M%S)"

# MySQL (RDS 外部实例)
export MYSQL_HOST="rm-xxxxxx.mysql.rds.aliyuncs.com"
export MYSQL_PORT="3306"
export MYSQL_DATABASE="zhiyu_test"
export MYSQL_USER="zhiyu"
# MYSQL_PASSWORD 和 MYSQL_ROOT_PASSWORD 应在 CI/CD Secret 中设置
export MYSQL_STORAGE=""

# Redis (外部 Sentinel)
export REDIS_HOST="r-xxxxxx.redis.rds.aliyuncs.com"
export REDIS_PORT="6379"
export REDIS_STORAGE=""

# Nacos (外部集群)
export NACOS_HOST="nacos.test.internal"
export NACOS_PORT="8848"
export NACOS_NAMESPACE="test"
export NACOS_STORAGE=""
export NACOS_USERNAME="nacos"
# NACOS_PASSWORD 应在 CI/CD Secret 中设置

# Nacos
export NACOS_CONFIG_ENABLED="true"
export NACOS_DISCOVERY_ENABLED="false"

# Spring
export SPRING_PROFILES_ACTIVE="test"

# JWT
export JWT_KEY_DIR="./deploy/secrets/test"

# HPA
export HPA_MIN_REPLICAS="1"
export HPA_MAX_REPLICAS="4"

# PDB
export PDB_MIN_AVAILABLE="1"

# Ingress
export INGRESS_HOST="test.zhiyu.app"
export INGRESS_CLASS="nginx"
export INGRESS_TLS_SECRET="zhiyu-test-tls"
export INGRESS_SSL_REDIRECT="true"

# ── cert-manager / Let's Encrypt ──────────
# test 环境使用 Let's Encrypt Staging（高频率限制，适合测试验证）
export CERT_MANAGER_ENABLED="true"
export CERT_MANAGER_CLUSTER_ISSUER="letsencrypt-staging"
export ACME_EMAIL="ops@zhiyu.app"
export ACME_SERVER="https://acme-staging-v02.api.letsencrypt.org/directory"
export CERT_MANAGER_ANNOTATION='cert-manager.io/cluster-issuer: "letsencrypt-staging"'
