<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ============================================================
         zhiyu-user — 用户资料模块（纯资料，不含认证）
         职责: 用户个人信息查看/编辑 / 偏好设置 / 账号注销
         依赖: zhiyu-auth
         被谁依赖: zhiyu-subscription, zhiyu-admin, zhiyu-server
         注意: TOTP/WebAuthn/设备管理已移至 zhiyu-auth
         ============================================================ -->
    <parent>
        <groupId>com.zhiyu</groupId>
        <artifactId>zhiyu-backend</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>zhiyu-user</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.zhiyu</groupId>
            <artifactId>zhiyu-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zhiyu</groupId>
            <artifactId>zhiyu-common</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
