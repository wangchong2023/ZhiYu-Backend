<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ============================================================
         zhiyu-auth — 业务认证模块
         职责: 注册/登录流程编排、验证码发送、密码重置、第三方OAuth绑定
         依赖: zhiyu-common（业务公共配置）+ ufp-auth（认证基础设施）
         被谁依赖: zhiyu-user, zhiyu-subscription, zhiyu-server
         ============================================================ -->
    <parent>
        <groupId>com.zhiyu</groupId>
        <artifactId>zhiyu-backend</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>zhiyu-auth</artifactId>

    <dependencies>
        <!-- UFP 认证基础设施（JWT/BCrypt/TOTP/Token黑名单） -->
        <dependency>
            <groupId>com.zhiyu</groupId>
            <artifactId>ufp-auth</artifactId>
        </dependency>
        <!-- ZhiYu 业务公共（MyBatis-Plus/Redis 配置，→ ufp-common 传递） -->
        <dependency>
            <groupId>com.zhiyu</groupId>
            <artifactId>zhiyu-common</artifactId>
        </dependency>

        <!-- Spring Security (JwtAuthFilter / SecurityConfig) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
    </dependencies>

</project>
